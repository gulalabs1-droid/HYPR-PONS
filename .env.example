# Demo mode needs no credentials and uses the local fixture adapter.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to use the pons public RPC for recent TokenLaunched events.
PONS_INDEXER_MODE=rpc
# The current adapter is explicitly Pons v1; v2 requires a separate ABI/address review.
# PONS_VERSION=v1
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Optional native HYPR protocol reader. Leave unset until a verified factory is deployed.
# HYPR_NETWORK=testnet
# HYPR_RPC_URL=https://rpc.testnet.chain.robinhood.com
# HYPR_FACTORY_ADDRESS=

# Opt-in Foundry fork proof only; this is read-only/local-fork execution and never broadcasts.
# HYPR_TESTNET_RPC_URL=https://rpc.testnet.chain.robinhood.com

# Optional public launch form configuration. Native launch/trade controls are
# intentionally testnet-only in this MVP; never put private keys here.
# NEXT_PUBLIC_HYPR_NETWORK=testnet
# NEXT_PUBLIC_HYPR_FACTORY_ADDRESS=

# For production backfills, use an archive-capable provider endpoint.
# PONS_ARCHIVE_RPC_URL=

# Optional Supabase persistence. Keep the service-role key server-side only;
# do not expose it through NEXT_PUBLIC_* variables.
# When both are set and the migration is applied, room claims use the durable
# server/RPC path; missing or unhealthy persistence fails closed.
# SUPABASE_URL=
# SUPABASE_ANON_KEY=
# SUPABASE_SERVICE_ROLE_KEY=

# Native HYPR live rooms. Keep these server-only.
# LIVEKIT_URL=wss://your-project.livekit.cloud
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=

# Optional one-shot server indexer. Requires the Supabase migration and the
# server-only service key; it performs RPC reads and database writes only.
# HYPR_INDEXER_SOURCE=pons
# Set to 1 to print the bounded batch and skip all database writes. This mode
# requires no Supabase credentials and never signs or broadcasts transactions.
# HYPR_INDEXER_DRY_RUN=1
