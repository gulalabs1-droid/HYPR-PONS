# Demo mode needs no credentials and uses the local fixture adapter.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Set to true to use the pons public RPC for recent TokenLaunched events.
PONS_INDEXER_MODE=fixture
PONS_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# For production backfills, use an archive-capable provider endpoint.
# PONS_ARCHIVE_RPC_URL=
